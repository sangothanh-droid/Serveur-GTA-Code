# Copier ce fichier en ".env" et remplir les vraies valeurs.
# Ne jamais committer le fichier ".env" (il est ignoré par git).

# --- Base de données (utilisée par docker-compose.yml et oxmysql) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qbcore
DB_USER=qbcore
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# --- Serveur FiveM ---
# Clé obtenue sur https://keymaster.fivem.net/
FIVEM_LICENSE_KEY=
# Clé Steam Web API : https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=

SERVER_NAME="Mon Serveur RP - Accès Libre"
SERVER_MAX_PLAYERS=48
SERVER_PORT=30120
