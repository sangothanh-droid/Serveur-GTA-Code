# FXServer runtime (téléchargé par setup.sh, ne pas versionner)
fxserver/
alpine/
run.sh

# Ressources tierces clonées par setup.sh
# (les crochets sont échappés : "[qb]" est un nom littéral de dossier, pas
# une classe de caractères glob)
server-data/resources/\[qb\]/
server-data/resources/\[standalone\]/oxmysql/

# Assets binaires des addons (véhicules/armes/maps) : à gérer séparément
# (poids, licence), pas dans ce repo Git.
server-data/resources/\[addons\]/*/stream/*
!server-data/resources/\[addons\]/*/stream/.gitkeep

# Secrets / config locale
.env
server-data/server.cfg.local

# Logs et cache
*.log
cache/
server-data/cache/
server-data/resources/*/cache/

# Sauvegardes de la base de données
backups/

# Divers OS/éditeurs
.DS_Store
*.swp
