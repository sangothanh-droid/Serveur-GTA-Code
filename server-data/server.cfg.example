# =========================================================
#  server.cfg - Serveur GTA RP en ACCÈS LIBRE (sans whitelist)
#  Généré pour FXServer + QBCore
# =========================================================

# --- Identité du serveur ---
sv_hostname "^2Mon Serveur RP ^7| ^3Accès Libre ^7- ^5FiveM"
sets sv_projectName "Mon Serveur RP"
sets sv_projectDesc "Serveur roleplay ouvert à tous, sans whitelist"
sets locale "fr-FR"
sets tags "roleplay, francophone, qbcore"

# --- Licence & réseau ---
# Clé obtenue sur https://keymaster.fivem.net/ (à ne jamais partager publiquement)
sv_licenseKey "PASTE_YOUR_LICENSE_KEY_HERE"
endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"

# --- Slots ---
sv_maxclients 48

# --- Accès libre : PAS de whitelist ---
# Ne jamais ajouter de ressource "whitelist" côté onResourceStart,
# ni de "add_ace group.whitelisted ..." ci-dessous.
# La seule modération se fait via les groupes admin définis plus bas.
add_ace group.admin command allow
add_ace group.admin command.quit allow
add_principal identifier.license:REPLACE_WITH_ADMIN_LICENSE group.admin

# qb-core doit pouvoir créer ses propres groupes de permissions (qbcore.user,
# qbcore.admin, ...) au démarrage via add_ace/add_principal - sans cette
# ligne ces appels échouent avec "Access denied for command add_ace".
add_ace resource.qb-core command allow

# --- Steam (optionnel mais recommandé pour l'anti-cheat/identité) ---
set steam_webApiKey "PASTE_YOUR_STEAM_WEB_API_KEY_HERE"

# --- Sécurité de base ---
sv_scriptHookAllowed 0
sv_enforceGameBuildDetection 1
set sv_enableNetworkedSounds 1

# --- Logs Discord (join/leave, acceptation du règlement) ---
# URL de type https://discord.com/api/webhooks/xxx/yyy - laisser vide pour désactiver.
setr rp_welcome_discord_webhook ""

# --- Logs Discord (annonce des points chauds de rp-gangwar-events) ---
setr rp_gangwar_discord_webhook ""

# --- Ressources système FiveM ---
ensure mapmanager
ensure chat
ensure spawnmanager
ensure sessionmanager
ensure baseevents
ensure hardcap
ensure rconlog

# --- File d'attente + écran de règlement (accès libre) ---
ensure rp-queue
ensure rp-welcome

# --- Base de données (doit démarrer avant tout ce qui en dépend) ---
ensure oxmysql
# FXServer n'interprète PAS les variables ${VAR} dans server.cfg : remplace
# ces valeurs par le contenu réel de ton .env (DB_USER, DB_PASSWORD, etc.),
# sinon oxmysql échoue avec "Access denied for user '${DB_USER}'".
set mysql_connection_string "mysql://PASTE_DB_USER:PASTE_DB_PASSWORD@PASTE_DB_HOST:PASTE_DB_PORT/PASTE_DB_NAME?charset=utf8mb4"

# --- Framework QBCore (doit démarrer avant rp-crime-core et les jobs) ---
ensure qb-core
ensure qb-multicharacter
ensure qb-spawn
# PolyZone, qb-interior et qb-clothing sont des dépendances de qb-apartments
# (voir dependencies{} dans son fxmanifest.lua) : sans elles la ressource
# échoue au démarrage.
ensure PolyZone
ensure qb-interior
ensure qb-clothing
ensure qb-apartments
# qb-weapons est une dépendance dure de qb-inventory (dependency 'qb-weapons'
# dans son fxmanifest.lua).
ensure qb-weapons
ensure qb-inventory
ensure qb-menu
ensure qb-input
ensure qb-hud
ensure qb-radialmenu
ensure qb-weathersync

# --- Réputation de gang / conséquences (nécessite oxmysql) ---
ensure rp-gangs

# --- Activités criminelles (nécessitent qb-core, rp-crime-core, rp-gangs) ---
# Voir docs/CRIME-JOBS.md pour le détail de chacune.
ensure rp-crime-core
ensure rp-shoprobbery
ensure rp-carjack
ensure rp-drugdealing
ensure rp-illegalrace
ensure rp-laundering
ensure rp-heist
ensure rp-armstrafficking
ensure rp-turfwar
ensure rp-weedfarm
ensure rp-atmrobbery
ensure rp-bountyhunter

# --- Labos (armes/drogue) et guerre pour leur monopole ---
# rp-labwars doit démarrer après rp-weaponlab et rp-druglab (il lit leurs
# emplacements de labo au démarrage). Voir docs/CRIME-JOBS.md.
ensure rp-weaponlab
ensure rp-druglab
ensure rp-labwars

# --- Événements de gang (nécessite rp-gangs et rp-crime-core) ---
# Toutes les Config.IntervalMs heures, annonce un "point chaud" temporaire
# sur un territoire aléatoire (voir docs/CRIME-JOBS.md).
ensure rp-gangwar-events

# --- Petites frappes solo, hors gangs officiels (voir docs/SOLO-CRIME.md) ---
# rp-streetrep doit démarrer avant les 3 autres (elles appellent
# exports['rp-streetrep']:AddStreetRep). Réservé aux joueurs sans gang
# (rp-crime-core:GetPlayerGang doit renvoyer nil), en parallèle du système
# de gangs qui reste inchangé.
ensure rp-streetrep
ensure rp-pettycrime
ensure rp-soloburglary
ensure rp-lonewolfcarjack

# --- Jobs légaux (voir docs/LEGAL-JOBS.md) ---
ensure rp-job-core
ensure rp-mechanic
ensure rp-security
ensure rp-realestate
ensure rp-taxi
ensure rp-delivery
ensure rp-garbage
ensure rp-lumberjack
ensure rp-fisherman
ensure rp-postal
ensure rp-busker
ensure rp-carwash

# --- Services publics (métiers assignés, nécessitent rp-job-core) ---
# rp-police et rp-ambulance utilisent les jobs 'police'/'ambulance' déjà
# fournis par défaut dans qb-core. rp-firefighter, rp-restaurant et
# rp-nightclub nécessitent d'ajouter leurs jobs (fire/burgershot/dj) via
# docs/qb-core-jobs-snippet.lua. Voir docs/LEGAL-JOBS.md.
ensure rp-police
ensure rp-ambulance
ensure rp-firefighter
ensure rp-restaurant
ensure rp-barber
ensure rp-nightclub

# --- Divertissement / social (ouverts à tous, sans lien gang/job) ---
ensure rp-casino
ensure rp-carmeet

# --- Contenus additionnels (véhicules/armes/maps) ---
# Décommenter et adapter après avoir rempli un template dans
# server-data/resources/[addons]/ (voir le README de ce dossier).
# ensure addon-my-car
# ensure addon-my-weapon
# ensure addon-my-map

# --- Carte / gameplay de base ---
# "fivem-map-hipster" ne correspond à aucun dépôt public existant (placeholder
# hérité d'un exemple de server.cfg) : laissé commenté pour éviter un
# "Couldn't find resource". La carte GTA V par défaut est utilisée à la place.
# ensure fivem-map-hipster
set gametype "Roleplay"
set mapname "san andreas"

# --- Divers ---
sv_pureLevel 0
sets sv_endpointprivacy true
